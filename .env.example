# Firebase Realtime Database Configuration
# Obtain your credentials from Firebase Console (Project Settings > General > Your apps)
# Create a .env file locally and fill in these values:

VITE_FB_API_KEY=your_firebase_api_key_here
VITE_FB_AUTH_DOMAIN=your_project_id.firebaseapp.com
VITE_FB_DATABASE_URL=https://your_project_id-default-rtdb.firebaseio.com/
VITE_FB_PROJECT_ID=your_project_id
